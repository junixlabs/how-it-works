{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "how-it-works/storyboard.schema.json",
  "title": "How It Works storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "id", "title", "language", "scenes"],
  "properties": {
    "schema_version": { "const": 1 },
    "kind": { "enum": ["task-tutorial", "feature-release", "architecture-explainer"] },
    "id": { "$ref": "#/definitions/slug" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "audience": { "type": "string", "maxLength": 160 },
    "outcome": { "type": "string", "maxLength": 200 },
    "language": { "type": "string", "pattern": "^[a-z]{2}$" },
    "locale": { "type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$" },
    "formats": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "enum": ["guide", "video-16x9", "video-9x16"] }
    },
    "product": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "name": { "type": "string" },
        "viewport": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 640, "maximum": 2560 }, "height": { "type": "integer", "minimum": 400, "maximum": 1600 } }
        }
      }
    },
    "diagrams": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/slug" },
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["type", "spec"],
        "properties": {
          "type": { "enum": ["architecture", "workflow", "sequence", "dataflow", "lifecycle"] },
          "spec": { "type": "string", "minLength": 1 }
        }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false, "required": ["version", "highlights"],
      "properties": {
        "version": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "highlights": { "type": "array", "minItems": 1, "maxItems": 5, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "tts": {
      "type": "object", "additionalProperties": false, "required": ["engine"],
      "properties": {
        "engine": { "enum": ["kokoro", "say", "none"] },
        "voice": { "type": "string" },
        "speed": { "type": "number", "minimum": 0.6, "maximum": 1.6 },
        "rate": { "type": "integer", "minimum": 100, "maximum": 260 }
      }
    },
    "audio": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "music": { "type": ["string", "null"] },
        "sfx": { "type": "boolean" }
      }
    },
    "copy": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "intro": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kicker": { "type": "string" }, "title": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "with": { "type": "string" }, "product": { "type": "string" }, "sub": { "type": "string" }
          }
        },
        "outro": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "kicker": { "type": "string" }, "title": { "type": "string" },
            "learned": { "type": "array", "items": { "type": "string" }, "maxItems": 4 }
          }
        },
        "guide": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "scenes": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/definitions/scene" } }
  },
  "definitions": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,47}$" },
    "target": {
      "type": "object", "additionalProperties": false, "minProperties": 1,
      "properties": {
        "role": { "type": "string" }, "name": { "type": "string" }, "placeholder": { "type": "string" },
        "testId": { "type": "string" }, "text": { "type": "string" }, "hasText": { "type": "string" },
        "child": { "$ref": "#/definitions/target" }
      }
    },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["do"],
      "properties": {
        "do": { "enum": ["goto", "click", "check", "type", "press"] },
        "path": { "type": "string" }, "target": { "$ref": "#/definitions/target" },
        "text": { "type": "string", "minLength": 1, "maxLength": 80 }, "key": { "type": "string" }
      }
    },
    "expect": {
      "type": "object", "minProperties": 1, "maxProperties": 1,
      "properties": {
        "visible": { "$ref": "#/definitions/target" },
        "text": { "type": "object" }, "class": { "type": "object" },
        "count": { "type": "object", "required": ["testId", "equals"] },
        "url": { "type": "object", "required": ["contains"] }
      },
      "additionalProperties": false
    },
    "scene": {
      "type": "object",
      "required": ["id", "kind", "title"],
      "properties": {
        "id": { "$ref": "#/definitions/slug" },
        "kind": { "enum": ["ui", "diagram", "title"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 40 },
        "narration": { "type": "string", "maxLength": 240 },
        "guide": {
          "type": "object", "additionalProperties": false,
          "properties": { "step": { "type": "string" } }
        },
        "actions": { "type": "array", "items": { "$ref": "#/definitions/action" } },
        "focus": {},
        "expect": { "type": "array", "items": { "$ref": "#/definitions/expect" } },
        "callout": { "type": "boolean" },
        "fx": { "enum": ["celebrate", "filter"] },
        "diagram": { "$ref": "#/definitions/slug" },
        "trace": { "type": "array", "items": { "type": "string" } },
        "heading": { "type": "string", "maxLength": 60 },
        "sub": { "type": "string", "maxLength": 120 },
        "intent": { "type": "string" }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "ui" } } },
          "then": {
            "required": ["actions", "focus", "expect", "narration"],
            "properties": { "focus": { "$ref": "#/definitions/target" }, "expect": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "diagram" } } },
          "then": {
            "required": ["diagram", "focus", "narration"],
            "properties": { "focus": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string" } } }
          }
        },
        {
          "if": { "properties": { "kind": { "const": "title" } } },
          "then": { "required": ["heading"] }
        }
      ]
    }
  }
}
